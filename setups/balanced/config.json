{
  "agent": {
    "nddev-builder": {
      "description": "NDDev setup manager builder and reviewer.",
      "mode": "all",
      "permission": {
        "agent_manager": "allow",
        "bash": {
          "*": "ask",
          "git diff*": "allow",
          "git log*": "allow",
          "git status*": "allow",
          "npm run test*": "allow",
          "npm test*": "allow",
          "python3 -m pytest*": "allow",
          "python3 -m unittest*": "allow"
        },
        "edit": "ask",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "read": "allow",
        "skill": "allow"
      },
      "prompt": "{file:instructions/nddev-builder.md}",
      "requirements": {
        "skills": [
          "nddev-builder"
        ]
      }
    }
  },
  "command": {
    "nddev-builder": {
      "agent": "nddev-builder",
      "description": "Load NDDev builder context.",
      "template": "Use the nddev-builder agent and skill to build or review the NDDev setup manager in this repository."
    }
  },
  "default_agent": "nddev-builder",
  "experimental": {
    "openTelemetry": false
  },
  "instructions": [
    "instructions/nddev-builder.md"
  ],
  "permission": {
    "agent_manager": "allow",
    "bash": {
      "*": "ask",
      "git diff*": "allow",
      "git log*": "allow",
      "git status*": "allow",
      "npm run test*": "allow",
      "npm test*": "allow",
      "python3 -m pytest*": "allow",
      "python3 -m unittest*": "allow"
    },
    "edit": "ask",
    "external_directory": "ask",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "read": "allow",
    "skill": "allow",
    "task": "allow",
    "webfetch": "ask",
    "websearch": "ask"
  },
  "sandbox": {
    "enabled": true,
    "network": "deny",
    "writable_paths": []
  },
  "skills": {
    "paths": [
      "skills"
    ]
  }
}
