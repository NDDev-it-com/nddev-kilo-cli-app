  "managed_config_keys": [
    "permission",
    "sandbox",
    "default_agent",
    "agent",
    "skills",
    "command",
    "instructions",
    "plugin",
    "experimental"
  ],
  "builder_enabled": true,
  "builder_projection": "native-agent-skill-command-plugin-config",
  "native_surfaces": [
    "AGENTS.md",
    "agent",
    "skills.paths",
