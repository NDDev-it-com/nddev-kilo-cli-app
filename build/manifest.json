{
  "schema_version": 1,
  "product_name": "nddev-kilo-cli-app",
  "build_version": "0.2.0",
  "runtime_baseline": "references/kilo-cli-baseline.json",
  "contract": "config/nddev-contract.json",
  "manager": "cli-tools/nddev_kilo_cli.py",
  "validator": "cli-tools/validate_public_contracts.py",
  "runtime": {
    "command": "kilo",
    "package": "@kilocode/cli",
    "version": "7.4.16",
    "target_owned_executable": "bin/kilo",
    "path_inherited": false,
    "subcommand": [
      "run"
    ],
    "auto_for_profiles": [
      "full-auto"
    ],
    "lifecycle_lock": "persistent-flock-held-through-child",
    "bootstrap_lock": {
      "kind": "external-product-uid-flock",
      "system_root": "fixed-real-sticky-system-temp",
      "macos_system_root": "/private/tmp",
      "ubuntu_system_root": "/tmp",
      "product_root_mode": "0700",
      "file_mode": "0600",
      "filename": "sha256-product-namespace-and-canonical-target",
      "target_binding": "json-product-canonical-target-and-sha256",
      "binding_exact": true,
      "binding_revalidated_before_yield": true,
      "fd_path_inode_revalidated_before_yield": true,
      "persistent_inode": true,
      "unlink_on_release": false,
      "acquire_order": "external-before-internal",
      "release_order": "internal-before-external",
      "child_env_exposed": false,
      "same_uid_tampering_resistant_without_sandbox": false
    },
    "lock_file": ".nddev-kilo-cli.lock/lock",
    "lock_file_mode": "0600",
    "lock_parent_mode_while_held": "0500",
    "lock_nonblocking_flock": true,
    "pre_child_executable_revalidation": true,
    "denies_lifecycle_mutations_while_running": true,
    "executable_handoff": {
      "kind": "write-protected-verified-path",
      "portable_fd_execution": false,
      "parent_mode_while_held": "0500",
      "protected_directory_scope": "lock-parent-and-software-launcher-artifacts-only",
      "runtime_directories_writable_while_running": true,
      "same_uid_chmod_resistant_without_sandbox": false
    },
    "runtime_directories": {
      "inside_target_only": true,
      "component_validation": "real-current-user-owned-0700",
      "reject_symlink_components": true,
      "writable_while_launch_running": true
    }
  },
  "software_lifecycle": {
    "manager_commands": [
      "software-status",
      "install-cli",
      "update-cli",
      "remove-cli"
    ],
    "installer": {
      "tool": "npm",
      "argv": [
        "install",
        "--global",
        "--ignore-scripts",
        "--save-exact",
        "--audit=false",
        "--fund=false",
        "--registry=https://registry.npmjs.org/",
        "@kilocode/cli@7.4.16"
      ],
      "package_integrity": "sha512-sOvq0HW6CZebCvGyUn0fTFj/1mX4nplpuoCJuqe6QjDUliLNYRC6ky9Rjl8kdT/nk0OGNO1kRaygEyc7+Htr2Q==",
      "package_shasum": "c39f0f94f1cae2aeed28b4a5b5a952a5efab2b1d",
      "lifecycle_scripts": "disabled",
      "nested_npm_fallback_allowed": false
    },
    "layout": {
      "bin": "bin/kilo",
      "global_dir": "install/npm-prefix",
      "package_lock": "software/package-lock.json",
      "manifest": "software/kilo-cli.json",
      "entrypoint_kind": "target-owned-native-wrapper",
      "native_executable_policy": "selected-native-package-bin-kilo"
    },
    "bounds": {
      "max_paths": 120000,
      "max_bytes": 1073741824
    }
  },
  "setups": [
    "nddev-builder"
  ],
  "permission_profiles": [
    "full-auto",
    "safe"
  ],
  "managed_state": [
    "xdg-config/kilo/kilo.jsonc",
    "AGENTS.md",
    "instructions/nddev-builder.md",
    "skills/nddev-builder/SKILL.md",
    "skills/nddev-builder/references/config.md",
    "skills/nddev-builder/references/permissions-sandbox.md",
    "skills/nddev-builder/references/agents-subagents.md",
    "skills/nddev-builder/references/skills.md",
    "skills/nddev-builder/references/commands.md",
    "skills/nddev-builder/references/plugins-hooks.md",
    "skills/nddev-builder/references/mcp-boundary.md",
    "skills/nddev-builder/references/auth-boundary.md",
    "skills/nddev-builder/references/memory-context.md",
    "skills/nddev-builder/references/install-runtime.md",
    "skills/nddev-builder/references/migration-validation.md",
    "skills/nddev-kilo-config/SKILL.md",
    "skills/nddev-kilo-permissions/SKILL.md",
    "skills/nddev-kilo-agents/SKILL.md",
    "skills/nddev-kilo-plugins/SKILL.md",
    "skills/nddev-kilo-runtime/SKILL.md",
    "xdg-config/kilo/agent/nddev-builder.md",
    "xdg-config/kilo/agent/nddev-reviewer.md",
    "xdg-config/kilo/command/nddev-builder.md",
    "xdg-config/kilo/command/nddev-check.md",
    "xdg-config/kilo/command/nddev-migrate.md",
    "xdg-config/kilo/nddev-builder-plugin.js"
  ]
}
