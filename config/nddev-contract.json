{
  "contract_version": 2,
  "product_name": "nddev-kilo-cli-app",
  "github_repository": "NDDev-it-com/nddev-kilo-cli-app",
  "license": "AGPL-3.0-or-later",
  "runtime_compatibility": {
    "current_version": "7.4.16",
    "minimum_version": "7.4.16",
    "package": "@kilocode/cli",
    "python_requires": ">=3.9",
    "official_source": {
      "documentation": "https://kilo.ai/docs/code-with-ai/platforms/cli",
      "repository": "https://github.com/Kilo-Org/kilocode",
      "npm": "https://registry.npmjs.org/@kilocode%2fcli/7.4.16",
      "latest_dist_tags": "https://registry.npmjs.org/@kilocode/cli"
    }
  },
  "runtime_launch": {
    "executable": "kilo",
    "subcommand": [
      "run"
    ],
    "auto_for_profiles": [
      "full-auto"
    ],
    "config_env": "KILO_CONFIG",
    "config_path": "xdg-config/kilo/kilo.jsonc",
    "isolated_child_home": true,
    "runtime_directories": {
      "inside_target_only": true,
      "component_validation": "real-current-user-owned-0700",
      "reject_symlink_components": true,
      "writable_while_launch_running": true
    },
    "path_inherited": false,
    "credential_inheritance": false,
    "forwards_child_exit_code": true,
    "lifecycle_lock": "persistent-flock-held-through-child",
    "cleanup_pending_policy": "drain-under-target-lock-before-launch-image-protection-child",
    "bootstrap_lock": {
      "kind": "external-product-anchor-and-persistent-target-flock",
      "system_root": "fixed-real-sticky-system-temp",
      "macos_system_root": "/private/tmp",
      "ubuntu_system_root": "/tmp",
      "product_root_mode": "0700",
      "file_mode": "0600",
      "product_anchor": "global.lock",
      "product_anchor_lifetime": "monotonic-persistent",
      "filename": "sha256-product-namespace-and-canonical-target",
      "target_anchor_lifetime": "mutation-published-monotonic-persistent",
      "target_binding": "json-product-canonical-target-and-sha256",
      "target_parent_symlink_policy": "safe-user-symlink-parents-canonicalized-after-product-lock",
      "binding_exact": true,
      "binding_publication": "atomic-temp-fsync-link-no-replace-parent-fsync",
      "hardlink_publication_alias_recovery": "mutation-only-lock-final-then-unlink-single-machine-temp-alias",
      "read_only_publication_alias_policy": "fail-closed-no-repair",
      "binding_revalidated_before_yield": true,
      "fd_path_inode_revalidated_before_yield": true,
      "read_only_anchor_policy": "no-create-product-anchor-and-no-create-target-anchor",
      "cold_read_policy": "inspect-with-anchor-absence-double-check",
      "persistent_inode": true,
      "unlink_on_release": false,
      "acquire_order": "external-before-internal",
      "release_order": "internal-before-external",
      "child_env_exposed": false,
      "same_uid_tampering_resistant_without_sandbox": false,
      "coordination_order": [
        "host",
        "lexical-target",
        "product-bootstrap-lock",
        "canonical-target-bootstrap-lock",
        "target-inspection"
      ]
    },
    "lock_file": ".nddev-kilo-cli.lock/lock",
    "lock_file_mode": "0600",
    "lock_parent_mode_while_held": "0500",
    "lock_nonblocking_flock": true,
    "pre_child_executable_revalidation": true,
    "denies_lifecycle_mutations_while_running": true,
    "executable_handoff": {
      "kind": "write-protected-verified-path",
      "portable_fd_execution": false,
      "parent_mode_while_held": "0500",
      "protected_directory_scope": "lock-parent-and-software-launcher-artifacts-only",
      "runtime_directories_writable_while_running": true,
      "same_uid_chmod_resistant_without_sandbox": false
    },
    "max_runtime_seconds": 3600
  },
  "setup_system": {
    "setup_ids": [
      "nddev-builder"
    ],
    "default_setup": "nddev-builder",
    "permission_profiles": [
      "full-auto",
      "safe"
    ],
    "default_permission_profile": "full-auto",
    "legacy_setup_ids": [
      "safe",
      "balanced",
      "full-auto"
    ],
    "lifecycle": [
      "list",
      "status",
      "plan",
      "install",
      "switch",
      "update",
      "migrate",
      "restore",
      "remove",
      "software-status",
      "install-cli",
      "update-cli",
      "remove-cli",
      "launch"
    ],
    "explicit_absolute_target": true,
    "target_bound_backup_slots": 10,
    "target_bound_reject_before": [
      "target",
      "setup",
      "bootstrap-lock",
      "internal-lock",
      "staging",
      "network",
      "launch"
    ],
    "cleanup_journal": {
      "kind": "bounded-target-owned-cleanup-journal",
      "root": ".nddev-kilo-cli-cleanup",
      "intent": "intent.json",
      "journal": "journal.json",
      "tombstone": "tombstone",
      "schema_version": 1,
      "root_mode": "0700",
      "journal_mode": "0600",
      "publication": "atomic-temp-fsync-link-no-replace-parent-fsync",
      "pre_move_intent": "durable-complete-intent-before-first-source-move",
      "intent_recovery": "mutation-only-restore-or-complete-under-exclusive-target-lock",
      "intent_source_binding": "fixed-anchor-relative-operation-kind-parent-identity",
      "hardlink_publication_alias_recovery": "mutation-only-under-exclusive-target-lock",
      "read_only_policy": "fail-closed-no-repair-on-incomplete-or-invalid",
      "deletion_paths": "journal-relative-tombstone-names-only",
      "absolute_deletion_paths": false,
      "top_level_cleanup_pending": true,
      "pending_noop_policy": "drain-is-lifecycle-work",
      "max_paths": 121328,
      "max_bytes": 1356857344,
      "serialized_max_bytes": 8388608
    },
    "plan_changed_paths": "actual-byte-diff",
    "mutation_changed_paths": "actual-byte-diff"
  },
  "managed_state": {
    "config_file": "xdg-config/kilo/kilo.jsonc",
    "stamp_file": "NDDEV-KILO-CLI-SETUP.json",
    "backup_envelope": "NDDEV-KILO-CLI-BACKUP.json",
    "managed_files": [
      "xdg-config/kilo/kilo.jsonc",
      "AGENTS.md",
      "instructions/nddev-builder.md",
      "skills/nddev-builder/SKILL.md",
      "skills/nddev-builder/references/config.md",
      "skills/nddev-builder/references/permissions-sandbox.md",
      "skills/nddev-builder/references/agents-subagents.md",
      "skills/nddev-builder/references/skills.md",
      "skills/nddev-builder/references/commands.md",
      "skills/nddev-builder/references/plugins-hooks.md",
      "skills/nddev-builder/references/mcp-boundary.md",
      "skills/nddev-builder/references/auth-boundary.md",
      "skills/nddev-builder/references/memory-context.md",
      "skills/nddev-builder/references/install-runtime.md",
      "skills/nddev-builder/references/migration-validation.md",
      "skills/nddev-kilo-config/SKILL.md",
      "skills/nddev-kilo-permissions/SKILL.md",
      "skills/nddev-kilo-agents/SKILL.md",
      "skills/nddev-kilo-plugins/SKILL.md",
      "skills/nddev-kilo-runtime/SKILL.md",
      "xdg-config/kilo/agent/nddev-builder.md",
      "xdg-config/kilo/agent/nddev-reviewer.md",
      "xdg-config/kilo/command/nddev-builder.md",
      "xdg-config/kilo/command/nddev-check.md",
      "xdg-config/kilo/command/nddev-migrate.md",
      "xdg-config/kilo/nddev-builder-plugin.js"
    ],
    "managed_config_keys": [
      "permission",
      "sandbox",
      "default_agent",
      "agent",
      "skills",
      "command",
      "instructions",
      "plugin",
      "experimental"
    ]
  },
  "software_lifecycle": {
    "package": "@kilocode/cli",
    "version": "7.4.16",
    "command": "kilo",
    "official_alias": "kilocode",
    "install_tool": "npm",
    "install_argv": [
      "install",
      "--global",
      "--ignore-scripts",
      "--save-exact",
      "--audit=false",
      "--fund=false",
      "--registry=https://registry.npmjs.org/",
      "@kilocode/cli@7.4.16"
    ],
    "package_integrity": "sha512-sOvq0HW6CZebCvGyUn0fTFj/1mX4nplpuoCJuqe6QjDUliLNYRC6ky9Rjl8kdT/nk0OGNO1kRaygEyc7+Htr2Q==",
    "package_shasum": "c39f0f94f1cae2aeed28b4a5b5a952a5efab2b1d",
    "lifecycle_scripts": "disabled",
    "official_postinstall": {
      "present": true,
      "script": "node ./postinstall.mjs",
      "executed": false,
      "nested_npm_fallback_allowed": false
    },
    "layout": {
      "bin": "bin/kilo",
      "global_dir": "install/npm-prefix",
      "package_lock": "software/package-lock.json",
      "manifest": "software/kilo-cli.json"
    },
    "status_executes_binary": false,
    "install_executes_target_binary": false,
    "entrypoint_kind": "target-owned-native-wrapper",
    "native_executable_policy": "selected-native-package-bin-kilo",
    "target_owned": true,
    "platform_scope": {
      "supported_hosts": [
        {
          "id": "macos-arm64",
          "os": "darwin",
          "cpu": "arm64",
          "libc": null,
          "distribution": null
        },
        {
          "id": "macos-x64",
          "os": "darwin",
          "cpu": "x64",
          "libc": null,
          "distribution": null
        },
        {
          "id": "ubuntu-glibc-arm64",
          "os": "linux",
          "cpu": "arm64",
          "libc": "glibc",
          "distribution": "ubuntu",
          "ubuntu_version_floor": null,
          "ubuntu_version_floor_source": "no-official-floor"
        },
        {
          "id": "ubuntu-glibc-x64",
          "os": "linux",
          "cpu": "x64",
          "libc": "glibc",
          "distribution": "ubuntu",
          "ubuntu_version_floor": null,
          "ubuntu_version_floor_source": "no-official-floor"
        }
      ],
      "unsupported_categories": [
        "windows",
        "non-ubuntu-linux",
        "linux-musl",
        "unsupported-architecture"
      ],
      "reject_before": [
        "target",
        "lock",
        "staging",
        "network",
        "launch"
      ],
      "vendor_package_preferences": {
        "macos-arm64": [
          "@kilocode/cli-darwin-arm64"
        ],
        "macos-x64": [
          "@kilocode/cli-darwin-x64-baseline",
          "@kilocode/cli-darwin-x64"
        ],
        "ubuntu-glibc-arm64": [
          "@kilocode/cli-linux-arm64"
        ],
        "ubuntu-glibc-x64": [
          "@kilocode/cli-linux-x64-baseline",
          "@kilocode/cli-linux-x64"
        ]
      },
      "vendor_optional_catalog": "references/kilo-cli-baseline.json:npm.native_packages.catalog"
    }
  },
  "builder": {
    "enabled_by_default": true,
    "projection": "native-agent-skill-command-plugin-config",
    "native_surfaces": [
      "AGENTS.md",
      "agent files",
      "skills.paths",
      "command files",
      "plugin",
      "permission",
      "sandbox"
    ],
    "marketplace": null,
    "mcp": null,
    "vscode_extensions": null,
    "plugin": {
      "kind": "local-file",
      "path": "xdg-config/kilo/nddev-builder-plugin.js",
      "config_spec": "./nddev-builder-plugin.js",
      "allowed_hooks": [
        "experimental.session.compacting"
      ],
      "external_imports": false
    }
  },
  "safety": {
    "preserve_unmanaged_config_keys": true,
    "preserve_unmanaged_files": true,
    "bounded_reads": true,
    "bounded_processes": true,
    "reject_target_symlink": true,
    "reject_managed_symlink": true,
    "reject_managed_hardlink": true,
    "drift_detection": true,
    "rollback_on_mutation_failure": true,
    "legacy_launch_denial": true,
    "live_state_default": "never"
  }
}
